FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12
# MySQL 8 example: mysql+pymysql://root:password@localhost:3306/edubridge
DATABASE_URL=sqlite:///edubridge.db
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PORT=5000
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=20
AUTO_CREATE_DB=1
