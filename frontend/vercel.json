
{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://edubridge-api-blpb.onrender.com/"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://YOUR-BACKEND.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
